# 可复制为 .env 后按需修改；.env 不入库（见 .gitignore）。
# npm start 不会自动读取 .env。生产构建后可用：node --env-file=.env dist-server/server/index.js
# 该文件只列出服务端运行时变量；前端没有编译期注入，全部通过运行时接口读取。

# 服务端口，默认 3001；容器内保持 3001，由 compose/反向代理对外映射
PORT=3001

# SQLite 数据目录，默认 ./data；容器内为 /app/data，必须挂载为持久化卷
# 目录中会有 bobing.sqlite、bobing.sqlite-wal、bobing.sqlite-shm，备份时不能只复制主库文件
DATA_DIR=./data

# 分享链接使用的对外地址（写入分享弹层的链接与二维码）
# 规则：必须是 http(s) 绝对地址；不得包含用户名/密码、查询串（?）或片段（#）
# 例：PUBLIC_BASE_URL=https://bobing.example.com
# 使用独立域名的根路径；当前路由与静态资源不支持 /bobing/ 一类子路径部署
# 留空时前端使用访问者当前地址（本机访问就是 localhost，不能发给互联网上的朋友）
PUBLIC_BASE_URL=

# 前置反向代理时设为 1，按 X-Forwarded-For 取客户端 IP 用于限流
# 直接把 3001 暴露到公网时保持 0，避免伪造 IP 绕过限流
TRUST_PROXY=0
